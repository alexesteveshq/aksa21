<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenCommission" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('top-content-center')]" position="before">
            <div class="button back" t-on-click="() => this.trigger('validate-price')">
                <span class="back_text">Validate price</span>
            </div>
        </xpath>
    </t>
</templates>
