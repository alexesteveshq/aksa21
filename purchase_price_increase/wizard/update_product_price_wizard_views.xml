<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="update_product_price_wizard_form" model="ir.ui.view">
        <field name="name">update.product.price.wizard.form</field>
        <field name="model">update.product.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Increase price">
                <group>
                    <field name="price_increase" required="1"/>
                </group>
                <footer>
                    <button name="update_price" string="Apply" type="object"
                            class="btn btn-sm btn-primary"/>
                    <button string="Cancel" class="btn btn-sm btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
