<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_occupancy" model="ir.ui.view">
        <field name="name">pos.session.form.occupancy</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cash_register_balance_start']" position="after">
                <field name="occupancy_percentage" widget="percentage"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_session_tree_occupancy" model="ir.ui.view">
        <field name="name">pos.session.tree.occupancy</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="occupancy_percentage" widget="percentage" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
