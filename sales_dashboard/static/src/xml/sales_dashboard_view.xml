<?xml version="1.0" encoding="UTF-8"?>
<t t-name="sales_dashboard.SalesDashboard" owl="1">
    <div class="o_sales_dashboard">
        <div class="o_sales_dashboard_container">
            <div class="o_sales_dashboard_filters">
                <label for="startDate">Start Date:</label>
                <input type="date" id="startDate" t-model="state.startDate" class="date-input"/>

                <label for="endDate">End Date:</label>
                <input type="date" id="endDate" t-model="state.endDate" class="date-input"/>

                <button class="btn btn-primary" t-on-click="applyDateFilter">Apply</button>
                <button class="btn btn-primary" t-on-click="resetDateFilter">Reset</button>
            </div>
            <!-- Row for the dashboard columns -->
            <div class="o_sales_dashboard_row">
                <!-- Column 1: Sales Dashboard (50% Width) -->
                <div class="o_sales_dashboard_column o_column_right">
                    <h2>Today's Sales by Company</h2>
                    <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                        <h3>Total Sales</h3>
                        <span t-esc="state.todaySales" />
                        <span t-if="state.todaySalesChange >= 0" style="color: green; font-size: 18px; line-height: 0;">
                            (+<t t-esc="state.todaySalesChange" />%)
                        </span>
                        <span t-else="" style="color: red; font-size: 18px; line-height: 0;">
                            (-<t t-esc="Math.abs(state.todaySalesChange)" />%)
                        </span>
                    </div>
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Current Sales</th>
                                <th>Cost</th>
                                <th>Change (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.todaySalesData" t-as="company" t-key="company.company">
                                <tr class="sales-section">
                                    <td><span t-esc="company.company" /></td>
                                    <td><span t-esc="company.current_sales" /> </td>
                                    <td><span t-esc="company.current_cost" /> </td>
                                    <td>
                                        <span t-esc="company.percentage_change" /> %
                                        <t t-if="company.percentage_change >= 0">
                                            <span style="color: green; font-size: 22px; font-weight: bold;">↑</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: red; font-size: 22px; font-weight: bold;">↓</span>
                                        </t>
                                    </td>
                                </tr>
                                <t t-if="company.order_details and company.order_details.length > 0">
                                    <tr class="ticket-section">
                                        <td colspan="4">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Ticket Reference</th>
                                                        <th>Payment method</th>
                                                        <th>Sale amount</th>
                                                        <th>Margin</th>
                                                        <th>Categories</th>
                                                        <th>Seller</th>
                                                        <th>Date</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="company.order_details || []" t-as="order" t-key="order.ticket_reference">
                                                        <td><span t-esc="order.ticket_reference" /></td>
                                                        <td><span t-esc="order.payment_method" /></td>
                                                        <td><span t-esc="order.amount_currency" /></td>
                                                        <td><span t-esc="order.margin" />%</td>
                                                        <td><span t-esc="order.categories" /></td>
                                                        <td><span t-esc="order.seller" /></td>
                                                        <td><span t-esc="order.datetime" /></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr class="ticket-section">
                                        <td colspan="4">
                                            <p class="text-center">No orders found.</p>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div class="mt-5">
                        <h3>Daily sales</h3>
                        <div style="height: 300px; margin-bottom: 30px;">
                            <canvas id="dailySalesGraph" style="width: 100%; height: 100%;"></canvas>
                        </div>
                    </div>
                </div>
                <div class="o_sales_dashboard_column o_column_left">
                    <h2>Sales Dashboard - Current Month</h2>
                    <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                        <h3>Total Sales</h3>
                        <span t-esc="state.totalSales" />
                        <span t-if="state.totalSalesChange >= 0" style="color: green; font-size: 18px;">
                            (+<t t-esc="state.totalSalesChange" />%)
                        </span>
                        <span t-else="" style="color: red; font-size: 18px;">
                            (-<t t-esc="Math.abs(state.totalSalesChange)" />%)
                        </span>
                        <div class="totals-details">
                            <div>
                                <h2>Total sales (without taxes)</h2>
                                <span t-esc="state.totalSalesWithoutTax" />
                            </div>
                            <div>
                                <h2>Total taxes</h2>
                                <span t-esc="state.totalTax" />
                            </div>
                        </div>
                    </div>

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Current Sales</th>
                                <th>Cost</th>
                                <th>Change (%)</th>
                                <th>Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.companySales" t-as="company" t-key="company.company">
                                <td>
                                    <span t-esc="company.company" />
                                </td>
                                <td>
                                    <span t-esc="company.current_sales" />
                                </td>
                                <td>
                                    <span t-esc="company.current_cost" />
                                </td>
                                <td>
                                    <span t-esc="company.percentage_change" /> %
                                    <t t-if="company.percentage_change >= 0">
                                        <span style="color: green; font-size: 22px; font-weight: bold">↑</span>
                                    </t>
                                    <t t-else="">
                                        <span style="color: red; font-size: 22px; font-weight: bold">↓</span>
                                    </t>
                                </td>
                                <td>
                                    <span t-esc="company.margin" />%
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Graph Canvas -->
                    <h4 class="mt-5">Predicted Sales for the Month</h4>
                    <div style="height: 300px; margin-bottom: 30px;">
                        <canvas id="salesPredictionGraph" style="width: 100%; height: 100%;"></canvas>
                    </div>

                    <h4>Best Selling Products by Category</h4>
                    <div style="display: grid; justify-content: center;">
                        <div id="bestSellingProductsGraph"/>
                    </div>

                    <div style="margin-top: 20px;">
                        <h2>Stock Statistics</h2>
                        <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                            <h3>Current Month Inventory</h3>
                            <div>
                                <h4>Total Products: <span t-esc="state.currentTotalQuantity" /></h4>
                                <h4>Total Cost: <span t-esc="state.currentTotalCost" /> </h4>
                            </div>
                        </div>

                        <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                            <h3>Previous Month Inventory</h3>
                            <div>
                                <h4>Total Products: <span t-esc="state.previousTotalQuantity" /></h4>
                                <h4>Total Cost: <span t-esc="state.previousTotalCost" /> </h4>
                            </div>
                        </div>

                        <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                            <h3>Total Weight</h3>
                            <div>
                                <h4>Total Gold: <span t-esc="state.totalGoldWeight" /> g</h4>
                                <h4>Total Silver: <span t-esc="state.totalSilverWeight" /> g</h4>
                            </div>
                        </div>
                    </div>
                    <div class="o_monthly_payments_table">
                        <h2>Payment Methods</h2>
                        <t t-if="state.loading">
                            <p>Loading...</p>
                        </t>
                        <t t-else="">
                            <table class="table table-hover table-bordered table-striped">
                                <thead>
                                    <!-- Main Headers (Categories) -->
                                    <tr>
                                        <th class="text-center align-middle">Company</th>
                                        <t t-foreach="state.categories" t-as="category" t-key="category">
                                            <th class="text-center" t-att-colspan="getCategoryColspan(category)">
                                                <t t-esc="category" />
                                            </th>
                                        </t>
                                    </tr>
                                    <!-- Sub-Headers (Currencies) -->
                                    <tr>
                                        <th>Totals</th>
                                        <t t-foreach="state.currencyPayments" t-as="category" t-key="category">
                                            <th class="text-center" t-att-colspan="getCurrencyColspan(category, 'MXN')">
                                                <t t-esc="state.currencyPayments[category]['MXN'] + ' (MXN)'"/>
                                            </th>
                                            <t t-if="category !== 'ROOMCHARGE'">
                                                <th class="text-center" t-att-colspan="getCurrencyColspan(category, 'USD')">
                                                    <t t-esc="state.currencyPayments[category]['USD'] + ' (USD)'"/>
                                                </th>
                                            </t>
                                        </t>
                                    </tr>
                                    <!-- Third Level Headers (Payment Methods) -->
                                    <tr>
                                        <th/>
                                        <t t-foreach="state.categories" t-as="category" t-key="category">
                                            <t t-foreach="state.paymentMethods[category]['MXN']" t-as="method" t-key="method">
                                                <th class="text-center"><t t-esc="state.paymentMethodsNames[method]" /></th>
                                            </t>
                                            <t t-if="category != 'ROOMCHARGE'">
                                                <t t-foreach="state.paymentMethods[category]['USD']" t-as="method" t-key="method">
                                                    <th class="text-center"><t t-esc="state.paymentMethodsNames[method]" /></th>
                                                </t>
                                            </t>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Company Payment Data -->
                                    <t t-foreach="state.monthlyPaymentsData" t-as="company_data" t-key="company_data.company">
                                        <tr>
                                            <td><t t-esc="company_data.company" /></td>
                                            <t t-foreach="state.categories" t-as="category" t-key="category">
                                                <!-- MXN Payment Methods -->
                                                <t t-foreach="state.paymentMethods[category]['MXN']" t-as="method" t-key="method">
                                                    <td class="text-right">
                                                        <t t-esc="company_data.payments[category]
                                                                    and company_data.payments[category]['MXN']
                                                                    and company_data.payments[category]['MXN'][method]
                                                                    or '0.00'" />
                                                    </td>
                                                </t>
                                                <!-- USD Payment Methods (Excluded for ROOMCHARGE) -->
                                                <t t-if="category != 'ROOMCHARGE'">
                                                    <t t-foreach="state.paymentMethods[category]['USD']" t-as="method" t-key="method">
                                                        <td class="text-right">
                                                            <t t-esc="company_data.payments[category]
                                                                        and company_data.payments[category]['USD']
                                                                        and company_data.payments[category]['USD'][method]
                                                                        or '0.00'" />
                                                        </td>
                                                    </t>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                    <div id="categoryBarGraphContainer" class="pt-5">
                        <h2>Product Stock by Category</h2>
                        <canvas id="categoryBarGraph"></canvas>
                    </div>
                </div>

                <!-- Modified Section: Seller Ranking -->
                <div class="o_sales_dashboard_column o_column_right" style="margin-top: 20px;">
                    <h3 style="text-align: center; margin-bottom: 20px;">Seller Ranking</h3>
                    <div class="ranking-container">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th>Seller</th>
                                    <th>Amount Sold</th> <!-- Merged change into amount sold -->
                                    <th>Commission</th>
                                    <th>Amount change %</th> <!-- Merged change into amount sold -->
                                    <th>Discount Avg</th> <!-- Merged change into discount avg -->
                                    <th>Discount change %</th>
                                    <th>Product count</th>
                                    <th>Order count</th>
                                    <th>Product/Order Avg</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="count" t-value="1"/>
                                <tr t-foreach="state.sellerRanking" t-as="seller" t-key="seller.id">
                                    <td><t t-esc="count"/></td>
                                    <td><span t-esc="seller.name" /></td>
                                    <td>
                                        <span t-esc="seller.amount_sold" />
                                    </td>
                                    <td>
                                        <span t-esc="seller.commission" />
                                    </td>
                                    <td>
                                        <span t-esc="seller.percentage_change" /> %
                                        <t t-if="seller.percentage_change >= 0">
                                            <span style="color: green; font-size: 22px; line-height: 0;">↑</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: red; font-size: 22px; line-height: 0;">↓</span>
                                        </t>
                                    </td>
                                    <td>
                                        <span t-esc="seller.discount_avg" /> %
                                    </td>
                                    <td>
                                        <t t-if="seller.discount_change">
                                            <span t-esc="seller.discount_change" /> %
                                            <t t-if="seller.discount_change > 0">
                                                <span style="color: red; font-size: 22px; line-height: 0;">↑</span>
                                            </t>
                                            <t t-else="">
                                                <span style="color: green; font-size: 22px; line-height: 0;">↓</span>
                                            </t>
                                        </t>
                                    </td>
                                    <td><span t-esc="seller.avg_products_sold" /></td> <!-- New Column -->
                                    <td><span t-esc="seller.avg_order_count" /></td> <!-- New Column -->
                                    <td><span t-esc="seller.avg_products_per_order" /></td> <!-- New Column -->
                                    <t t-set="count" t-value="count+1" />
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Column 2: POS Order Statistics (50% Width) -->
                <div class="o_sales_dashboard_column o_column_right mt-5">
                    <h2>POS Order Statistics</h2>

                    <!-- Order Amount Average Block -->
                    <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                        <h3>Order Amount Average</h3>
                        <span t-esc="state.orderAvg" />
                        <span t-if="state.orderAvgChange >= 0" style="color: green; font-size: 18px;">
                            (+<t t-esc="state.orderAvgChange" />%)
                        </span>
                        <span t-else="" style="color: red; font-size: 18px;">
                            (-<t t-esc="Math.abs(state.orderAvgChange)" />%)
                        </span>
                    </div>

                    <!-- Order Count Block -->
                    <div class="o_dashboard_blue_block" style="margin-bottom: 20px;">
                        <h3>Number of Orders</h3>
                        <span t-esc="state.orderCount" />
                        <span t-if="state.orderCountChange >= 0" style="color: green; font-size: 18px;">
                            (+<t t-esc="state.orderCountChange" />)
                        </span>
                        <span t-else="" style="color: red; font-size: 18px;">
                            (-<t t-esc="Math.abs(state.orderCountChange)" />)
                        </span>
                    </div>

                    <!-- Discount Average Block with percentage format -->
                    <div class="o_dashboard_blue_block">
                        <h3>Discount Average</h3>
                        <span t-esc="state.discountAvg" /> %
                        <span t-if="state.discountAvgChange > 0" style="color: red; font-size: 18px;">
                            (+<t t-esc="state.discountAvgChange" />%)
                        </span>
                        <span t-else="" style="color: green; font-size: 18px;">
                            (-<t t-esc="Math.abs(state.discountAvgChange)" />%)
                        </span>
                    </div>

                    <div class="o_dashboard_blue_block">
                        <h3>Product/Order Average</h3>
                        <span t-esc="state.OrderProdAvg" />
                    </div>
                    <div class="o_monthly_sales_table">
                        <h2>Monthly sales</h2>
                        <div class="monthly-sales-wrapper">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Year</th>
                                        <th>Month</th>
                                        <th>Total Sales</th>
                                        <th>Total Cost</th>
                                        <th>Total Orders</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.monthlySalesData" t-as="month" t-key="month.year + month.month">
                                        <!-- Main Row: Monthly Summary -->
                                        <tr class="sales-section">
                                            <td><t t-esc="month.year" /></td>
                                            <td><t t-esc="month.month" /></td>
                                            <td><t t-esc="month.total_sales" /></td>
                                            <td><t t-esc="month.total_cost" /></td>
                                            <td><t t-esc="month.total_orders" /></td>
                                        </tr>
                                        <!-- Details Row: Toggable Tickets -->
                                        <t t-if="month.tickets and month.tickets.length > 0">
                                            <tr class="ticket-section">
                                                <td colspan="5">
                                                    <div class="ranking-container">
                                                        <table class="table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Ticket Reference</th>
                                                                    <th>Sale Amount</th>
                                                                    <th>Margin</th>
                                                                    <th>Categories</th>
                                                                    <th>Seller</th>
                                                                    <th>Date</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr t-foreach="month.tickets || []" t-as="ticket" t-key="ticket.id">
                                                                    <td><t t-esc="ticket.ticket_reference" /></td>
                                                                    <td><t t-esc="ticket.amount" /></td>
                                                                    <td><t t-esc="ticket.margin"/>%</td>
                                                                    <td><t t-esc="ticket.categories"/></td>
                                                                    <td><t t-esc="ticket.seller" /></td>
                                                                    <td><t t-esc="ticket.datetime" /></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr class="ticket-section">
                                                <td colspan="5">
                                                    <p class="text-center">No tickets found for this month.</p>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</t>
