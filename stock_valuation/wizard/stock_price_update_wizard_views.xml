<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_price_update_wizard_form" model="ir.ui.view">
        <field name="name">stock.price.update.wizard.form</field>
        <field name="model">stock.price.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Update">
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="category_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="percentage"/>
                        <field name="print_labels"/>
                        <field name="piece_count"/>
                    </group>
                </group>
                <footer>
                    <button name="action_update_prices" string="Update" type="object"
                            class="btn btn-sm btn-primary"
                            confirm="Prices of all the pieces in stock matching the filters will be updated. Continue?"/>
                    <button string="Cancel" class="btn btn-sm btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
